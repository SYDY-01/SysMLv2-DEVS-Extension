package UAVMissionSystem {

    // 1. 基础数据类型声明
    attribute def bool;
    attribute def double;

    // (占位：FlightMissionControl, Payload, Radar, AutoPilot, oper 会在这里)

    // ==========================================
    // 2. 控制总线模块 (ControlBusModule)
    // 核心亮点：基于状态变量的高级条件分支输出
    // ==========================================
    devs atomic def ControlBusModule {
        in port evInstruct : double;
        out port evSensorPrep : bool;
        out port evActuatorEnable : bool;
        out port evPayloadActivate : bool;
        out port evPowerModev1 : bool;
        out port evHighPowerOn : bool;
        out port evPowerModev2 : bool;
        out port evPowerModev3 : bool;

        state idle;
        state tran;

        // 时间推进：idle 态无限等待，tran 态执行 0.001 秒的极短驻留
        ta def computeDuration {
            idle : INFINITE;
            tran : 0.001;
        }

        // 外部转移：收到指令时跃迁到 tran 状态
        delta_ext def externalLogic {
            idle -> tran when evInstruct;
        }

        // 内部转移：处理完毕后自动回归 idle
        delta_int def internalLogic {
            tran -> idle;
        }

        // 输出函数：根据指令类型 (evInstruct) 路由不同的布尔控制信号
        lambda def outputLogic {
            tran -> idle do {
                if (evInstruct == 10000) {
                    evSensorPrep = true;
                    evActuatorEnable = true;
                } else if (evInstruct == 11000) {
                    evPayloadActivate = true;
                } else if (evInstruct == 10101) {
                    evPowerModev1 = true;
                    evHighPowerOn = true;
                } else if (evInstruct == 10010) {
                    evPowerModev2 = true;
                } else if (evInstruct == 10001) {
                    evPowerModev1 = true;
                } else {
                    evPowerModev3 = true;
                }
            };
        }
    }

    // ==========================================
    // 3. 电池模块 (Battery)
    // 核心亮点：利用零时延 (0) 状态实现瞬时输出响应
    // ==========================================
    devs atomic def Battery {
        in port evstart : bool;
        out port voltage : double;

        state idle;
        state discharge0;
        state discharge;

        ta def computeDuration {
            idle : INFINITE;
            discharge0 : 0;        // 零时延瞬态
            discharge : INFINITE;
        }

        delta_ext def externalLogic {
            idle -> discharge0 when evstart;
        }

        delta_int def internalLogic {
            discharge0 -> discharge;
        }

        lambda def outputLogic {
            discharge0 -> discharge do {
                voltage = 28.5;
            };
        }
    }


    // ==========================================
    // 4. 有效载荷模块 (Payload)
    // 亮点：在内部转移 (delta_int) 中执行物理量更新
    // ==========================================
    devs atomic def Payload {
        in port evPayloadActivate : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state on;
        state over;

        ta def computeDuration {
            off : INFINITE;
            on : 15;        // 工作 15 秒后自动结束
            over : INFINITE;
        }

        delta_ext def externalLogic {
            // 收到电压时保持 off 状态 (等待激活)
            off -> off when voltage;
            // 收到激活指令，开启载荷，产生 1A 电流
            off -> on when evPayloadActivate do {
                current = 1;
            };
        }

        delta_int def internalLogic {
            // 15秒工作结束后，电流归零，状态进入 over
            on -> over do {
                current = 0;
            };
        }
    }

    // ==========================================
    // 5. 雷达模块 (Radar)
    // 亮点：纯反应式组件 (所有状态 ta 均为 INFINITE)
    // ==========================================
    devs atomic def Radar {
        in port evSensorPrep : bool;
        in port evHighPowerOn : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state yure;         // 预热状态
        state gaoyajietong; // 高压接通状态

        ta def computeDuration {
            off : INFINITE;
            yure : INFINITE;
            gaoyajietong : INFINITE;
        }

        delta_ext def externalLogic {
            off -> off when voltage;
            
            // 收到预热指令，电流飙升至 20A
            off -> yure when evSensorPrep do {
                current = 20;
            };
            
            // 收到高压接通指令，电流飙升至 30A
            yure -> gaoyajietong when evHighPowerOn do {
                current = 30;
            };
        }
    }

    // ==========================================
    // 6. 自动驾驶仪 (AutoPilot)
    // 亮点：多重外部中断与极短的瞬态 (tran) 刷新机制
    // ==========================================
    devs atomic def AutoPilot {
        in port evActuatorEnable : bool;
        in port evPowerModev1 : bool;
        in port evPowerModev2 : bool;
        in port evPowerModev3 : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state on;
        state tran;

        ta def computeDuration {
            off : INFINITE;
            on : INFINITE;
            tran : 0.001;    // 瞬态打断机制
        }

        delta_ext def externalLogic {
            off -> off when voltage;
            
            // 激活执行机构，初始电流 30A
            off -> on when evActuatorEnable do {
                current = 30;
            };
            
            // 在运行中随时响应功耗模式切换指令
            on -> tran when evPowerModev1 do { current = 18; };
            on -> tran when evPowerModev2 do { current = 30; };
            on -> tran when evPowerModev3 do { current = 28; };
        }

        delta_int def internalLogic {
            // 瞬态极速返回 on 状态
            tran -> on;
        }
    }


    // ==========================================
    // 7. 操作员激励发生器 (oper)
    // 亮点：单次触发 (Single-Shot) 逻辑
    // ==========================================
    devs atomic def oper {
        out port evstart : bool;

        state idle;
        state off;

        // 仿真启动后 0.001s 触发，随后进入无限期休眠
        ta def computeDuration {
            idle : 0.001;
            off : INFINITE;
        }

        delta_int def internalLogic {
            idle -> off;
        }

        lambda def outputLogic {
            idle -> off do {
                evstart = true;
            };
        }
    }

    // ==========================================
    // 8. 飞行任务主控 (FlightMissionControl)
    // 亮点：基于时间序列的复杂自主内部状态机
    // ==========================================
    devs atomic def FlightMissionControl {
        in port evstart : bool;
        out port evInstruct : double;

        state idle;
        state takeoff_climb0;
        state takeoff_climb;
        state fadongjizhunbeidianhuo;
        state motor_ignition;
        state cruise_turn;
        state descent;
        state pingfei2;
        state ercijianggao;
        state pingfei3;
        state landing_approach;
        state finish;

        // 严密的时间推进时间轴定义
        ta def computeDuration {
            idle : INFINITE;
            takeoff_climb0 : 0.001;
            takeoff_climb : 100;
            fadongjizhunbeidianhuo : 50;
            motor_ignition : 250;
            cruise_turn : 6950;
            descent : 250;
            pingfei2 : 7000;
            ercijianggao : 100;
            pingfei3 : 8300;
            landing_approach : 5.5;
            finish : INFINITE; // 默认未在 C++ 显式定义的，均视为死寂态
        }

        // 唯一外部转移：接收起飞指令启动状态机
        delta_ext def externalLogic {
            idle -> takeoff_climb0 when evstart;
        }

        // 纯时间驱动的内部序列转移
        delta_int def internalLogic {
            takeoff_climb0 -> takeoff_climb;
            takeoff_climb -> fadongjizhunbeidianhuo;
            fadongjizhunbeidianhuo -> motor_ignition;
            motor_ignition -> cruise_turn;
            cruise_turn -> descent;
            descent -> pingfei2;
            pingfei2 -> ercijianggao;
            ercijianggao -> pingfei3;
            pingfei3 -> landing_approach;
            landing_approach -> finish;
        }

        // 在关键状态变迁时发送指令码 (Instruction Codes)
        lambda def outputLogic {
            takeoff_climb0 -> takeoff_climb do { evInstruct = 10000; };
            takeoff_climb -> fadongjizhunbeidianhuo do { evInstruct = 11000; };
            descent -> pingfei2 do { evInstruct = 10101; };
            pingfei2 -> ercijianggao do { evInstruct = 10010; };
            ercijianggao -> pingfei3 do { evInstruct = 10001; };
            pingfei3 -> landing_approach do { evInstruct = 10011; };
        }
    }



    // ==========================================
    // 9. UAV 顶层耦合系统 (Coupled DEVS)
    // ==========================================
    devs coupled def UAV_mission_system0411 {
        
        // 实例化所有子模块 (D 集合)
        part FC : FlightMissionControl;
        part CBM : ControlBusModule;
        part BAT : Battery;
        part PL : Payload;
        part RADAR : Radar;
        part AP : AutoPilot;
        part OP : oper;

        // 建立全系统拓扑连接路由矩阵 (IC 集合)
        connect OP.evstart to FC.evstart;
        connect FC.evInstruct to CBM.evInstruct;
        connect CBM.evSensorPrep to RADAR.evSensorPrep;
        connect CBM.evActuatorEnable to AP.evActuatorEnable;
        connect CBM.evPayloadActivate to PL.evPayloadActivate;
        connect CBM.evPowerModev1 to AP.evPowerModev1;
        connect CBM.evHighPowerOn to RADAR.evHighPowerOn;
        connect CBM.evPowerModev2 to AP.evPowerModev2;
        connect CBM.evPowerModev3 to AP.evPowerModev3;
        
        // 电池电压的一对多广播
        connect BAT.voltage to AP.voltage;
        connect BAT.voltage to PL.voltage;
        connect BAT.voltage to RADAR.voltage;
        
        connect OP.evstart to BAT.evstart;
    }
}