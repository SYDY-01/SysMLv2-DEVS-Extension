package TrafficLightSystem {

    attribute def double;

    // ==========================================
    // 1. Pedestrian Button Generator (Automatically generates test signals)
    // ==========================================
    devs atomic def PedestrianGen {
        out port change_req : double;

        state waiting;
        state triggering;

        ta def computeDuration {
            waiting : 45;
            triggering : 0.1;
        }

        delta_int def internalLogic {
            waiting -> triggering;
            triggering -> waiting;
        }

        lambda def outputLogic {
            triggering -> waiting do {
                change_req = 1;
            };
        }
    }

    // ==========================================
    // Traffic Light Controller (Demonstrates internal/external transition competition)
    // ==========================================
    devs atomic def TrafficLight {
        in port ped_request : double;
        out port light_status : double;

        state Green;
        state Yellow;
        state Red;

        // Time advancement rule
        ta def computeDuration {
            Green : 60;
            Yellow : 5;
            Red : 30;
        }

        // External transition rule: When a pedestrian request is received during green light, preemptively switch to yellow light
        delta_ext def externalLogic {
            Green -> Yellow when ped_request;
        }

        // Internal transition rule: Natural rotation when time expires
        delta_int def internalLogic {
            Green -> Yellow;
            Yellow -> Red;
            Red -> Green;
        }

        // Output function rule: Broadcast current light color when state changes (1=Green, 2=Yellow, 3=Red)
        lambda def outputLogic {
            Green -> Yellow do { light_status = 2; };
            Yellow -> Red do { light_status = 3; };
            Red -> Green do { light_status = 1; };
        }
    }

    // ==========================================
    // 3. Intersection Coupled Model
    // ==========================================
    devs coupled def Intersection {
        
        part pGen : PedestrianGen;
        part myLight : TrafficLight;

        connect pGen.change_req to myLight.ped_request;
    }
}