package Model31_ClinicalLabDefs {
    attribute def double;
    attribute def string;
    
    enum def SampleStatus { 
        Pending; 
        Processing; 
        Completed; 
        Error; 
    }
    
    port def BioSamplePort;
    port def DigitalDataPort;

    part def Centrifuge {
        attribute maxRpm : double = 5000.0;
        attribute modelName : string = "SpinMax2000";
        in port sampleIn : BioSamplePort;
        out port processedOut : BioSamplePort;
    }
    
    part def BiochemicalAnalyzer {
        attribute currentStatus : SampleStatus = SampleStatus::Pending;
        in port sampleIn : BioSamplePort;
        out port resultOut : DigitalDataPort;
    }
}