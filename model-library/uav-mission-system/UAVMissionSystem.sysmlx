package UAVMissionSystem {

    // 1. Basic Data Type Declarations
    attribute def bool;
    attribute def double;

    // (Placeholder: FlightMissionControl, Payload, Radar, AutoPilot, oper will be here)

    // ==========================================
    // 2. Control Bus Module
    // Core Feature: Advanced conditional branch output based on state variables
    // ==========================================
    devs atomic def ControlBusModule {
        in port evInstruct : double;
        out port evSensorPrep : bool;
        out port evActuatorEnable : bool;
        out port evPayloadActivate : bool;
        out port evPowerModev1 : bool;
        out port evHighPowerOn : bool;
        out port evPowerModev2 : bool;
        out port evPowerModev3 : bool;

        state idle;
        state tran;

        // Time Advancement: Infinite wait in idle state, 0.001s transient dwell in tran state
        ta def computeDuration {
            idle : INFINITE;
            tran : 0.001;
        }

        // External Transition: Transition to tran state when instruction is received
        delta_ext def externalLogic {
            idle -> tran when evInstruct;
        }

        // Internal Transition: Automatically return to idle after processing
        delta_int def internalLogic {
            tran -> idle;
        }

        // Output Function: Route different boolean control signals based on instruction type (evInstruct)
        lambda def outputLogic {
            tran -> idle do {
                if (evInstruct == 10000) {
                    evSensorPrep = true;
                    evActuatorEnable = true;
                } else if (evInstruct == 11000) {
                    evPayloadActivate = true;
                } else if (evInstruct == 10101) {
                    evPowerModev1 = true;
                    evHighPowerOn = true;
                } else if (evInstruct == 10010) {
                    evPowerModev2 = true;
                } else if (evInstruct == 10001) {
                    evPowerModev1 = true;
                } else {
                    evPowerModev3 = true;
                }
            };
        }
    }

    // ==========================================
    // 3. Battery Module
    // Core Feature: Instantaneous output response using zero-delay (0) state
    // ==========================================
    devs atomic def Battery {
        in port evstart : bool;
        out port voltage : double;

        state idle;
        state discharge0;
        state discharge;

        ta def computeDuration {
            idle : INFINITE;
            discharge0 : 0;        // Zero-delay transient state
            discharge : INFINITE;
        }

        delta_ext def externalLogic {
            idle -> discharge0 when evstart;
        }

        delta_int def internalLogic {
            discharge0 -> discharge;
        }

        lambda def outputLogic {
            discharge0 -> discharge do {
                voltage = 28.5;
            };
        }
    }


    // ==========================================
    // 4. Payload Module
    // Feature: Physical quantity update in internal transition (delta_int)
    // ==========================================
    devs atomic def Payload {
        in port evPayloadActivate : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state on;
        state over;

        ta def computeDuration {
            off : INFINITE;
            on : 15;        // Automatically ends after 15 seconds of operation
            over : INFINITE;
        }

        delta_ext def externalLogic {
            // Maintain off state when voltage is received (waiting for activation)
            off -> off when voltage;
            // Receive activation command, turn on payload, generate 1A current
            off -> on when evPayloadActivate do {
                current = 1;
            };
        }

        delta_int def internalLogic {
            // After 15 seconds of operation, reset current to 0 and enter over state
            on -> over do {
                current = 0;
            };
        }
    }

    // ==========================================
    // 5. Radar Module
    // Feature: Purely reactive component (all state ta are INFINITE)
    // ==========================================
    devs atomic def Radar {
        in port evSensorPrep : bool;
        in port evHighPowerOn : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state yure;         // Preheating state
        state gaoyajietong; // High voltage connection state

        ta def computeDuration {
            off : INFINITE;
            yure : INFINITE;
            gaoyajietong : INFINITE;
        }

        delta_ext def externalLogic {
            off -> off when voltage;
            
            // Receive preheating command, current surges to 20A
            off -> yure when evSensorPrep do {
                current = 20;
            };
            
            // Receive high voltage connection command, current surges to 30A
            yure -> gaoyajietong when evHighPowerOn do {
                current = 30;
            };
        }
    }

    // ==========================================
    // 6. AutoPilot Module
    // Feature: Multiple external interrupts and extremely short transient (tran) refresh mechanism
    // ==========================================
    devs atomic def AutoPilot {
        in port evActuatorEnable : bool;
        in port evPowerModev1 : bool;
        in port evPowerModev2 : bool;
        in port evPowerModev3 : bool;
        in port voltage : double;
        out port current : double;

        state off;
        state on;
        state tran;

        ta def computeDuration {
            off : INFINITE;
            on : INFINITE;
            tran : 0.001;    // Transient interrupt mechanism
        }

        delta_ext def externalLogic {
            off -> off when voltage;
            
            // Activate actuators, initial current 30A
            off -> on when evActuatorEnable do {
                current = 30;
            };
            
            // Respond to power mode switching commands at any time during operation
            on -> tran when evPowerModev1 do { current = 18; };
            on -> tran when evPowerModev2 do { current = 30; };
            on -> tran when evPowerModev3 do { current = 28; };
        }

        delta_int def internalLogic {
            // Transient state quickly returns to on state
            tran -> on;
        }
    }


    // ==========================================
    // 7. Operator Stimulus Generator
    // Feature: Single-Shot logic
    // ==========================================
    devs atomic def oper {
        out port evstart : bool;

        state idle;
        state off;

        // Trigger 0.001s after simulation starts, then enter infinite sleep
        ta def computeDuration {
            idle : 0.001;
            off : INFINITE;
        }

        delta_int def internalLogic {
            idle -> off;
        }

        lambda def outputLogic {
            idle -> off do {
                evstart = true;
            };
        }
    }

    // ==========================================
    // 8. Flight Mission Control
    // Feature: Complex autonomous internal state machine based on time series
    // ==========================================
    devs atomic def FlightMissionControl {
        in port evstart : bool;
        out port evInstruct : double;

        state idle;
        state takeoff_climb0;
        state takeoff_climb;
        state fadongjizhunbeidianhuo; // Engine preparation for ignition
        state motor_ignition;
        state cruise_turn;
        state descent;
        state pingfei2;               // Level flight phase 2
        state ercijianggao;           // Secondary climb
        state pingfei3;               // Level flight phase 3
        state landing_approach;
        state finish;

        // Strict time advancement timeline definition
        ta def computeDuration {
            idle : INFINITE;
            takeoff_climb0 : 0.001;
            takeoff_climb : 100;
            fadongjizhunbeidianhuo : 50;
            motor_ignition : 250;
            cruise_turn : 6950;
            descent : 250;
            pingfei2 : 7000;
            ercijianggao : 100;
            pingfei3 : 8300;
            landing_approach : 5.5;
            finish : INFINITE; // All states not explicitly defined in C++ are considered dead states
        }

        // Only external transition: Receive takeoff command to start state machine
        delta_ext def externalLogic {
            idle -> takeoff_climb0 when evstart;
        }

        // Pure time-driven internal sequence transitions
        delta_int def internalLogic {
            takeoff_climb0 -> takeoff_climb;
            takeoff_climb -> fadongjizhunbeidianhuo;
            fadongjizhunbeidianhuo -> motor_ignition;
            motor_ignition -> cruise_turn;
            cruise_turn -> descent;
            descent -> pingfei2;
            pingfei2 -> ercijianggao;
            ercijianggao -> pingfei3;
            pingfei3 -> landing_approach;
            landing_approach -> finish;
        }

        // Send instruction codes at critical state transitions
        lambda def outputLogic {
            takeoff_climb0 -> takeoff_climb do { evInstruct = 10000; };
            takeoff_climb -> fadongjizhunbeidianhuo do { evInstruct = 11000; };
            descent -> pingfei2 do { evInstruct = 10101; };
            pingfei2 -> ercijianggao do { evInstruct = 10010; };
            ercijianggao -> pingfei3 do { evInstruct = 10001; };
            pingfei3 -> landing_approach do { evInstruct = 10011; };
        }
    }



    // ==========================================
    // 9. UAV Top-Level Coupled System (Coupled DEVS)
    // ==========================================
    devs coupled def UAV_mission_system0411 {
        
        // Instantiate all submodules (Set D)
        part FC : FlightMissionControl;
        part CBM : ControlBusModule;
        part BAT : Battery;
        part PL : Payload;
        part RADAR : Radar;
        part AP : AutoPilot;
        part OP : oper;

        // Establish full system topology connection routing matrix (Set IC)
        connect OP.evstart to FC.evstart;
        connect FC.evInstruct to CBM.evInstruct;
        connect CBM.evSensorPrep to RADAR.evSensorPrep;
        connect CBM.evActuatorEnable to AP.evActuatorEnable;
        connect CBM.evPayloadActivate to PL.evPayloadActivate;
        connect CBM.evPowerModev1 to AP.evPowerModev1;
        connect CBM.evHighPowerOn to RADAR.evHighPowerOn;
        connect CBM.evPowerModev2 to AP.evPowerModev2;
        connect CBM.evPowerModev3 to AP.evPowerModev3;
        
        // One-to-many broadcast of battery voltage
        connect BAT.voltage to AP.voltage;
        connect BAT.voltage to PL.voltage;
        connect BAT.voltage to RADAR.voltage;
        
        connect OP.evstart to BAT.evstart;
    }
}